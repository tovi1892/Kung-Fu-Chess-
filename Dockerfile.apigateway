# Multi-stage Dockerfile for the REST API Gateway - stateless login/register/profile/
# leaderboard HTTP service over PostgresAccountRepository (see ApiGateway/ApiGateway.hpp).
# Needs libpqxx/OpenSSL like Dockerfile.server (same PostgresAccountRepository code, now
# shared via the kungfu_accounts library - see CMakeLists.txt), but no OpenCV/BUILD_APP, no
# BUILD_TESTS - only kungfu_api_gateway is built here.

# Stage 1: Build Environment
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Same package list as Dockerfile.server's builder stage - ca-certificates is required here
# (not just for completeness) because CMake's FetchContent does a real `git clone` over
# https:// for ixwebsocket/Catch2/sqlite3/nlohmann_json during the build step further down.
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    g++ \
    libpqxx-dev \
    libssl-dev \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

# Same TLS-verification workaround as Dockerfile.server - see its comment for the full
# explanation.
RUN git config --global http.sslVerify false

# Only kungfu_api_gateway needs building - no tests, no OpenCV-dependent app/UI.
# KUNGFU_ENABLE_POSTGRES turns on PostgresAccountRepository (needs libpqxx-dev above) and is
# also what gates the kungfu_api_gateway target itself into existing at all (see CMakeLists.txt).
RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DKUNGFU_ENABLE_POSTGRES=ON -DBUILD_TESTS=OFF -DBUILD_APP=OFF \
    && cmake --build build --config Release --target kungfu_api_gateway

# Stage 2: Minimal Production Runtime
FROM ubuntu:22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

# Reinstalling libpqxx-dev/libssl-dev here rather than guessing the versioned runtime-only
# package names - same reasoning Dockerfile.server documents. curl (not netcat) since this
# service speaks real HTTP, unlike kungfu_server/kungfu_gateway's raw WebSocket.
RUN apt-get update && apt-get install -y \
    libpqxx-dev \
    libssl-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/kungfu_api_gateway /app/kungfu_api_gateway

EXPOSE 8081

# Unlike kungfu_server/kungfu_gateway's TCP-connect-only healthcheck, this service speaks
# real HTTP - curl a real endpoint. /leaderboard needs no request body and always returns 200
# (even "[]" with zero rows), making it the simplest genuine proof-of-health without adding a
# dedicated /health route this slice doesn't otherwise need.
HEALTHCHECK --interval=5s --timeout=5s --retries=5 --start-period=5s \
    CMD curl -f http://localhost:8081/leaderboard || exit 1

CMD ["/app/kungfu_api_gateway"]
