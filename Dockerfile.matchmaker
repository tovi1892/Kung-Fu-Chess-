# Multi-stage Dockerfile for the standalone Matchmaker - a cross-shard QuickMatch pairing
# service backed by Redis (see Matchmaker/Matchmaker.hpp). Needs neither libpqxx/OpenSSL nor
# OpenCV - just kungfu_network plus hiredis, same shape as Dockerfile.gateway.

# Stage 1: Build Environment
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# ca-certificates is required here (not just for completeness) because CMake's FetchContent
# does a real `git clone` over https:// for ixwebsocket during the build step further down -
# see Dockerfile.server's identical comment for why.
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    g++ \
    pkg-config \
    libhiredis-dev \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

# Same TLS-verification workaround as Dockerfile.server - see its comment for the full
# explanation (this build environment's network breaks HTTPS cert verification for git
# specifically, confirmed independent of ca-certificates being installed).
RUN git config --global http.sslVerify false

# Only kungfu_matchmaker needs building - no tests, no OpenCV-dependent app/UI, no Postgres.
# KUNGFU_ENABLE_REDIS turns on RedisWaitQueue (needs libhiredis-dev above) and is also what
# gates the kungfu_matchmaker target itself into existing at all (see CMakeLists.txt).
RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTS=OFF -DBUILD_APP=OFF -DKUNGFU_ENABLE_REDIS=ON \
    && cmake --build build --config Release --target kungfu_matchmaker

# Stage 2: Minimal Production Runtime
FROM ubuntu:22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

# Reinstalling libhiredis-dev here rather than guessing the versioned runtime-only package
# name - same reasoning Dockerfile.server documents for libpqxx-dev/libssl-dev.
RUN apt-get update && apt-get install -y \
    libhiredis-dev \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/kungfu_matchmaker /app/kungfu_matchmaker

EXPOSE 9100

# Same reasoning as Dockerfile.gateway's HEALTHCHECK - raw WebSocket, not HTTP, so a plain TCP
# connect is the simplest real proof the process is up and accepting connections.
HEALTHCHECK --interval=5s --timeout=5s --retries=5 --start-period=5s \
    CMD nc -z localhost 9100 || exit 1

CMD ["/app/kungfu_matchmaker"]
