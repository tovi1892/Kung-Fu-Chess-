# Use the Session pooler host (Project Settings -> Database -> Connection pooling), not the
# direct db.<project-ref>.supabase.co host - the direct host resolves to an IPv6-only address
# in many regions, which is unreachable from Docker's default bridge network.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=changeme
SUPABASE_DB_NAME=postgres
